# Required environment variables.
#
# Set every one of these in Vercel (Project > Settings > Environment Variables)
# before deploying. The code deliberately has NO fallback defaults: a literal
# default in the source is a working credential for anyone who can read the
# repo. On Aug 8 2026 that is exactly how the client report passwords and the
# portal JWT secret leaked, so the routes now fail closed instead.
#
# Copy this file to .env.local for local development. .env.local is gitignored.

# Basic-auth password for /reports/chelleon and /reports/chelleon-dashboard.
# Both share one credential so the client team has a single password.
REPORT_CHELLEON_PASSWORD=

# Basic-auth password for /reports/sleepypiglet.
REPORT_SLEEPYPIGLET_PASSWORD=

# Basic-auth password for /reports/sleepypiglet-market.
REPORT_SLEEPYPIGLET_MARKET_PASSWORD=

# Signing key for the portal session cookie (middleware.ts + lib/portal-auth.ts).
# Generate with: openssl rand -base64 48
# Rotating this invalidates every existing portal session.
PORTAL_JWT_SECRET=

# Sanity write token used by the client portal queries (lib/portal-queries.ts).
# Read-only browsing works without it; portal writes do not.
SANITY_WRITE_TOKEN=

# Meta Conversions API (api/meta-capi). The pixel ID is public by nature and
# has a safe default in code; the access token has none.
META_PIXEL_ID=
META_ACCESS_TOKEN=
